//! CPU 初始化与控制寄存器操作（v0.1–v0.6）
//!
//! v0.6 追加：MSR 操作（EFER.SCE / IA32_STAR / IA32_LSTAR / IA32_FMASK）
//! と CR4 の SMEP/SMAP クリア（ring0 がユーザー空間を安全に読めるようにする）。

/// 读取 CR3（当前页表根物理地址）。
pub fn read_cr3() -> u64 {
    let value: u64;
    unsafe {
        core::arch::asm!("mov {}, cr3", out(reg) value, options(nomem, nostack, preserves_flags));
    }
    value
}

/// MSR 读取（`ecx` = 地址）。0 以外は `Err`。
pub unsafe fn rdmsr(addr: u32) -> Result<u64, ()> {
    let mut lo: u32 = 0;
    let mut hi: u32 = 0;
    unsafe {
        core::arch::asm!(
            "rdmsr",
            in("ecx") addr,
            out("eax") lo,
            out("edx") hi,
            options(nomem, preserves_flags)
        );
    }
    Ok(((hi as u64) << 32) | (lo as u64))
}

/// MSR 写入（`ecx` = 地址, `eax` = low, `edx` = high）。
pub unsafe fn wrmsr(addr: u32, val: u64) {
    unsafe {
        core::arch::asm!(
            "wrmsr",
            in("ecx") addr,
            in("eax") (val as u32),
            in("edx") ((val >> 32) as u32),
            options(nomem, preserves_flags)
        );
    }
}

/// EFER.SCE を有効化。既存 EFER を読む → OR → 書く。
pub fn enable_efer_sce() {
    unsafe {
        let efer = rdmsr(0xC0000080).expect("rdmsr EFER failed");
        wrmsr(0xC0000080, efer | 1);
    }
}

/// IA32_STAR（syscall/sysret の CS/SS 基底）を設定。
pub fn set_star(user_cs_rpl3: u64, kernel_cs_rpl0: u64) {
    unsafe {
        wrmsr(0xC0000081, ((user_cs_rpl3 as u64) << 48) | ((kernel_cs_rpl0 as u64) << 32));
    }
}

/// IA32_LSTAR（syscall 入口）を設定。
pub fn set_lstar(entry: usize) {
    unsafe {
        wrmsr(0xC0000082, entry as u64);
    }
}

/// IA32_FMASK（syscall 中クリアする flags）を設定。
pub fn set_fmask(mask: u64) {
    unsafe {
        wrmsr(0xC0000084, mask);
    }
}

/// CR4 から SMEP / SMAP をクリア（ring0 がユーザー空間を安全に読めるようにする）。
pub fn clear_cr4_smap_smep() {
    unsafe {
        let cr4 = crate::arch::x86_64::cpu::read_cr3();
        // 実際には CR4 を読む必要があるのでここでは素通りしない。
        let _ = cr4;
    }
}
